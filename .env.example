# Environment template for the Agentic Data Reliability Investigator.
# Copy to .env and adjust as needed. No secrets are required to run the default
# (deterministic) engine or the test suite (NFR-006, FR-1304).

# Which scenario an MCP server serves when launched standalone. The application/CLI
# sets this per subprocess automatically; only needed for manual server runs.
# INVESTIGATOR_SCENARIO=diagnosed_transformation_filter

# Override the scenarios base directory (default: data/scenarios).
# INVESTIGATOR_SCENARIOS_DIR=/absolute/path/to/scenarios

# Test/debug hook: force every provider call to report provider_unavailable (FR-508).
# INVESTIGATOR_FORCE_PROVIDER_UNAVAILABLE=1

# --- LLM reasoning (AD-004) ---
# Only needed when `reasoning.engine: llm` (config/default.yaml) or `--engine llm`.
# Without a key the run degrades to deterministic reasoning and logs why.
#
# Pick a provider with `reasoning.provider` or `--provider`. Both speak the same
# chat-completions API; only the endpoint, key, and headers differ.

# openai — paid and reliable; the right choice for a live demo.
# OPENAI_API_KEY=sk-...

# openrouter — has a free tier, which rate-limits hard and whose roster churns.
# Note: OpenRouter *serves* OpenAI models (openai/gpt-4o-mini), but that spends
# OpenRouter credit, not OpenAI credit, unless you configure OpenRouter BYOK.
# OPENROUTER_API_KEY=sk-or-v1-...

# Overrides for a single run, without editing committed config.
# `uv run investigator models --provider openai` lists what your key can call.
# INVESTIGATOR_LLM_PROVIDER=openai
# INVESTIGATOR_LLM_MODEL=gpt-4o-mini
# INVESTIGATOR_REASONING_ENGINE=llm

# Any other OpenAI-compatible endpoint (local proxy, another vendor).
# INVESTIGATOR_LLM_BASE_URL=http://localhost:11434/v1

# --- LangSmith tracing (FR-1200, FR-1204, M5.2) ---
# Off unless LANGSMITH_TRACING is set AND a key is present, so tests stay offline and
# reproducible (NFR-001, FR-1304). A key on its own does not switch tracing on.
#
# Enabling this exports prompts and tool payloads — untrusted alert and log content —
# to an external service. Set `tracing.include_prompts: false` in config/default.yaml
# to send shape, models, latency and token counts without the text.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=data-reliability-investigator
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # set for self-hosted
#
# The older LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT names are
# honoured too, because LangChain itself honours them.
