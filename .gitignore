data/reviews/*.json
data/incidents/INC-inv_*.json
data/backlog/imp_*.json
evaluations/*.json

# Local editor/agent settings
.claude/settings.local.json

# OS
.DS_Store

# Run journals (M5.1) — regenerated per run
outputs/journal/*.json

